{
  "name": "pr-agent-runner",
  "version": "0.1.0",
  "description": "AI-powered PR review automation: runs OpenCodeReview (OCR) on PRs and handles @mention review/fix/chat commands, packaged as a reusable GitHub composite action.",
  "license": "BSD-3-Clause",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/makinosp/pr-agent-runner.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:coverage:lcov": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^20.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@octokit/types": "^16.0.0",
    "@types/node": "^26.1.1",
    "oxlint": "^1.76.0",
    "typescript": "~7.0.2"
  }
}
